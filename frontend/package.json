{
  "name": "omega-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs && tauri icon src-tauri/app-icon.json",
    "build": "tsc && vite build",
    "build:tauri": "tsc && vite build --mode tauri",
    "test": "vitest run",
    "lint": "eslint .",
    "prettier": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "prettier:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "preview": "vite preview",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:install": "tauri build --no-bundle && sh scripts/install-desktop.sh",
    "desktop:uninstall": "sh scripts/install-desktop.sh --uninstall",
    "tauri": "tauri"
  },
  "dependencies": {
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.1.2",
    "@mui/material": "^7.2.0",
    "@mui/styled-engine": "^7.0.2",
    "@tanstack/react-query": "^5.81.5",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "axios": "^1.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "idb": "^8.0.4",
    "jwt-decode": "^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^7.4.0",
    "react-swipeable": "^7.0.2",
    "rrule": "^2.8.1",
    "tailwind-merge": "^3.3.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.7",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.2.6",
    "globals": "^15.14.0",
    "postcss": "^8.5.3",
    "prettier": "^3.7.3",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.1.7",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.18.2",
    "vite": "^7.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.5"
  }
}
